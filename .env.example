PORT=3000
HOST=127.0.0.1
JSON_BODY_LIMIT=100mb
MAX_IMPORT_FILE_BYTES=157286400
VISITOR_REFRESH_COOLDOWN_MS=60000
TRUST_PROXY=loopback
MAX_HISTORY_IMPORT_ROWS=1000000
# 可选：目标站允许代理访问时使用。代理凭据只保存在服务端环境变量中。
SHOP_API_PROXY_MODE=on_challenge
SHOP_API_PROXY_URL=
# 浏览器采集默认复用系统 Chrome/Edge。Linux 云端可指定浏览器路径并通过虚拟显示运行有界面模式。
SHOP_BROWSER_EXECUTABLE=
SHOP_BROWSER_HEADLESS=false
SHOP_BROWSER_TIMEOUT=30000
# 首次启动后在本机网页创建管理员账户，无需在此保存密码。
# ADMIN_TOKEN/USER_TOKEN 仅用于兼容旧版共享令牌，不建议新部署使用。
